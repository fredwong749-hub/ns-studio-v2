# ns2 worker 生产开关（rollback.sh to-new / restart-worker 起 worker 前 source；改了要重启 worker 才生效）。
# 项目方 11-10 出差授权：有数据支撑就开，变差回滚（删行或改 0 → bash ns2/rollback.sh restart-worker）。依据见 reports/p6/。
export NS2_MID_NO_FEET=1          # 中景不补看不见的鞋（r4_mid_no_feet.md：中景带鞋句远两档 22% vs 3%）
export NS2_LINEUP_FACING=1        # 排排站几何判不算两人转向相反（r4_lineup_facing.md：20/20 误判）
export NS2_SAME_FAIL_STOP=1       # 视频连续两条同样没过（泛红/身份/硬切）就停用尽力版（r4_video_same_fail_replay.md：省 10.5% 丢 3/206）
export NS2_NO_BOARD_FALLBACK=1    # 双人首帧第 3 次不退参考板（r4_staging_ab.md：参考板画成拼图）
# export NS2_PREVIZ_FIT=1         # 摆位图修距离 / 朝向：实测无改善，保持关
# export NS2_ASYNC_SCORE=1        # 首/尾帧图出完就放道、后台等打分（ep07：渲染 123 s / 整单 190 s，打分占 35–40%）——上线前在服务器验
